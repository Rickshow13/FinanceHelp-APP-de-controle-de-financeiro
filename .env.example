# Molde do arquivo .env (o arquivo .env de verdade NUNCA vai para o GitHub)
# Copie este arquivo, renomeie a cópia para .env e preencha com os dados do SEU projeto no Supabase

# Endereço do projeto (no Supabase: Project Settings > Data API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (no Supabase: Project Settings > API Keys > Publishable key)
EXPO_PUBLIC_SUPABASE_KEY=sua-chave-publica-aqui