{
  "expo": {
    "name": "FinanceHelp",
    "slug": "meu-financeiro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/financehelp/icon.png",
    "scheme": "meufinanceiro",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/financehelp/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/financehelp/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/financehelp/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}